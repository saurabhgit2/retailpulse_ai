# Copy to .env and adjust. .env is git-ignored: it holds secrets.

# --- Application -------------------------------------------------------------
APP_ENV=development            # development | production
LOG_LEVEL=INFO
# Origins allowed to call this API from a browser. The Vite dev server proxies
# /api, so this matters mainly when the frontend is deployed separately.
CORS_ORIGINS=http://localhost:5173

# --- Database ----------------------------------------------------------------
# Matches docker-compose.yml. postgresql+psycopg = SQLAlchemy dialect + driver.
DATABASE_URL=postgresql+psycopg://retailpulse:change-me@localhost:5432/retailpulse
# Separate database for the test suite; created by: docker compose exec db createdb -U retailpulse retailpulse_test
TEST_DATABASE_URL=postgresql+psycopg://retailpulse:change-me@localhost:5432/retailpulse_test

# --- Security ----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=60

# --- Uploads -----------------------------------------------------------------
UPLOAD_DIR=../data/uploads
MAX_UPLOAD_MB=200
MAX_COLUMNS=200
MIN_CLEAN_ROWS=100
