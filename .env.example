# Copy this file to .env and adjust.
#
# IMPORTANT: every variable that starts with VITE_ is bundled into the JavaScript
# that the browser downloads. Anyone can read it. Never put secrets here.

# Base path of the REST API (the Vite dev server proxies /api to the backend).
VITE_API_BASE_URL=/api/v1

# true  = use the in-browser mock API (no backend needed; data stays in this browser)
# false = call the real FastAPI backend
VITE_USE_MOCK_API=true

# Client-side upload limit in MB. The backend enforces its own limit (MAX_UPLOAD_MB).
VITE_MAX_UPLOAD_MB=200

# Where the dev-server proxy sends /api requests. No VITE_ prefix, so it is only
# read by vite.config.js and never reaches the browser.
DEV_API_TARGET=http://localhost:8000
